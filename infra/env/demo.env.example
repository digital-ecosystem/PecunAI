# Demo environment for S2S Finance (PecunAI) — the build shown to prospects.
#
# Copy to /opt/s2s-finance-demo/.env and fill in. NEVER commit the filled-in file — .env* is
# gitignored, which is also what lets the deploy's `git checkout --force` leave secrets alone.
#
# Do NOT copy production's .env wholesale. This machine is going to be handed around and shown
# to outsiders — assume everything on it is readable by whoever is in the room. Give it its own
# credentials for everything, and never production's.

# ── The three that matter most ───────────────────────────────────────────────────────────────

# Selects the SignTeq work area. Anything other than the literal "production" makes the app use
# SIGNTEQ_*_DEV — the test work area. Set to "production" here and the demo would create real
# signature requests against real advisors in the live work area.
# The literal value "demo" also switches on the per-session delete control in the customer
# dashboard (DEMO_MODE in src/app/customer/dashboard/page.tsx), so a demo can be reset between
# viewings without deleting rows by hand. That control does not exist in any other build.
NEXT_PUBLIC_ENV="demo"

# Must resolve to the demo DB service, never production's. setup-demo.sh refuses to run if this
# doesn't name `demo-db`. Host is the compose service name — resolved on demo-net.
DATABASE_URL="postgresql://<user>:<password>@demo-db:5432/<db>?schema=public"

# How the browser and the SignTeq/signd webhooks reach the demo. Baked into the client bundle at
# BUILD time, so it comes from the GitHub repo variable DEMO_NEXT_PUBLIC_FRONTEND_URL for the
# image; this copy serves the server side. Keep the two identical.
NEXT_PUBLIC_FRONTEND_URL="http://<vps-ip>:4003"

# ── Database (must agree with DATABASE_URL above) ────────────────────────────────────────────
POSTGRES_USER=""
POSTGRES_PASSWORD=""
POSTGRES_DB=""

# ── Port binding ─────────────────────────────────────────────────────────────────────────────
# 0.0.0.0 while the demo has no nginx in front of it — otherwise it is unreachable. Change to
# 127.0.0.1 the moment a hostname and TLS exist, so only nginx can reach the app.
DEMO_BIND="0.0.0.0"

# ── Auth ─────────────────────────────────────────────────────────────────────────────────────
# Generate fresh — do not reuse production's or staging's. A demo token must be valid nowhere
# else.
#   openssl rand -base64 32
JWT_SECRET=""
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://<vps-ip>:4003"

# ── OpenAI ───────────────────────────────────────────────────────────────────────────────────
# Realtime voice sessions cost money per minute. Prefer a separate key with its own budget cap,
# so a stuck demo session cannot spend production's quota.
OPENAI_API_KEY=""

# ── SignTeq — the DEV/test work area ─────────────────────────────────────────────────────────
# Only the *_DEV values are read while NEXT_PUBLIC_ENV is not "production". Leave the *_PRO keys
# out of this file entirely: what isn't here can't be reached by accident.
SIGNTEQ_API_KEY_DEV=""
SIGNTEQ_ORG_ID_DEV=""
SIGNTEQ_WEBHOOK_SECRET_DEV=""
SIGNTEQ_QES_LOGIN_DEV=""
SIGNTEQ_QES_TOKEN_DEV=""

# ── signd.id identity verification ───────────────────────────────────────────────────────────
SIGND_API_BASE=""
SIGND_WEB_BASE=""
SIGND_WEBHOOK_SECRET=""

# ── Mail ─────────────────────────────────────────────────────────────────────────────────────
# The demo sends real email — OTP login needs it. Point it at a catch-all mailbox (Mailtrap, or
# an address you own) rather than the production relay. A demo in front of an audience must not
# be able to mail a real customer.
EMAIL_SMTP_HOST=""
EMAIL_SMTP_PORT=""
EMAIL_SMTP_USER=""
EMAIL_SMTP_PASSWORD=""
EMAIL_FROM=""
DEV_TEST_RECIPIENT_EMAIL=""

# ── OTP throttle ─────────────────────────────────────────────────────────────────────────────
OTP_RESEND_LIMIT="5"
OTP_WINDOW_MINUTES="15"
