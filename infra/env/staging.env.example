# Staging environment for S2S Finance (PecunAI).
#
# Copy to /opt/s2s-finance-staging/.env and fill in. NEVER commit the filled-in file — .env* is
# gitignored, which is also what lets the deploy's `git checkout --force` leave secrets alone.
#
# Do NOT copy production's .env wholesale. Three values below are what keep staging from acting
# on the real world; the rest can be shared or, better, be their own staging credentials.

# ── The three that matter most ───────────────────────────────────────────────────────────────

# Selects the SignTeq work area. Anything other than the literal "production" makes the app use
# SIGNTEQ_*_DEV — the test work area. Set to "production" here and staging would create real
# signature requests against real advisors in the live work area.
# ("development" instead of "staging" additionally turns on magicFlow and the debug autofill
# button — faster to click through, less like production. Your call; "staging" mirrors prod.)
NEXT_PUBLIC_ENV="staging"

# Must resolve to the staging DB service, never production's. setup-staging.sh refuses to run if
# this doesn't name `staging-db`. Host is the compose service name — resolved on staging-net.
DATABASE_URL="postgresql://<user>:<password>@staging-db:5432/<db>?schema=public"

# How the browser and the SignTeq/signd webhooks reach staging. Baked into the client bundle at
# BUILD time, so it comes from the GitHub repo variable STAGING_NEXT_PUBLIC_FRONTEND_URL for the
# image; this copy serves the server side. Keep the two identical.
NEXT_PUBLIC_FRONTEND_URL="http://<vps-ip>:4002"

# ── Database (must agree with DATABASE_URL above) ────────────────────────────────────────────
POSTGRES_USER=""
POSTGRES_PASSWORD=""
POSTGRES_DB=""

# ── Port binding ─────────────────────────────────────────────────────────────────────────────
# 0.0.0.0 while staging has no nginx in front of it — otherwise it is unreachable. Change to
# 127.0.0.1 the moment a hostname and TLS exist, so only nginx can reach the app.
STAGING_BIND="0.0.0.0"

# ── Auth ─────────────────────────────────────────────────────────────────────────────────────
# Generate fresh — do not reuse production's. A staging token must not be valid on production.
#   openssl rand -base64 32
JWT_SECRET=""
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://<vps-ip>:4002"

# ── OpenAI ───────────────────────────────────────────────────────────────────────────────────
# Realtime voice sessions cost money per minute. Prefer a separate key with its own budget cap,
# so a stuck staging session cannot spend production's quota.
OPENAI_API_KEY=""

# ── SignTeq — the DEV/test work area ─────────────────────────────────────────────────────────
# Only the *_DEV values are read while NEXT_PUBLIC_ENV is not "production". Leave the *_PRO keys
# out of this file entirely: what isn't here can't be reached by accident.
SIGNTEQ_API_KEY_DEV=""
SIGNTEQ_ORG_ID_DEV=""
SIGNTEQ_WEBHOOK_SECRET_DEV=""
SIGNTEQ_QES_LOGIN_DEV=""
SIGNTEQ_QES_TOKEN_DEV=""

# ── signd.id identity verification ───────────────────────────────────────────────────────────
SIGND_API_BASE=""
SIGND_WEB_BASE=""
SIGND_WEBHOOK_SECRET=""

# ── Mail ─────────────────────────────────────────────────────────────────────────────────────
# Staging sends real email — advisor OTP login needs it. Point it at a catch-all mailbox
# (Mailtrap, or an address you own) rather than the production relay, so a test run can never
# mail a real customer.
EMAIL_SMTP_HOST=""
EMAIL_SMTP_PORT=""
EMAIL_SMTP_USER=""
EMAIL_SMTP_PASSWORD=""
EMAIL_FROM=""
DEV_TEST_RECIPIENT_EMAIL=""

# ── OTP throttle ─────────────────────────────────────────────────────────────────────────────
OTP_RESEND_LIMIT="5"
OTP_WINDOW_MINUTES="15"
